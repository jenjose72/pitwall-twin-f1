# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# F1 Replayer
F1_CACHE_DIR=/data/f1_cache
REPLAY_SPEED=1.0

# Telemetry Topics
TELEMETRY_TOPIC=f1.telemetry
LAPS_TOPIC=f1.laps
RACE_CONTROL_TOPIC=f1.race_control
WEATHER_TOPIC=f1.weather

# InfluxDB
INFLUXDB_DB=pitwall
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=admin_password

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SECURITY_ADMIN_USER=admin
